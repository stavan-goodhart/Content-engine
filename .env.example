# Slack app: enable Socket Mode, install in workspace, invite to #content-eng
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-socket-mode-token
SLACK_CHANNEL_ID=C0123456789
# Comma-separated Slack IDs. Leave empty to allow everyone in the designated channel.
APPROVER_IDS=

# OpenAI Responses API (web search used for grounded article research)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Sanity hosts content; does NOT host this Slack process
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_STUDIO_URL=
GHL_BLOG_BASE_URL=https://ghartlabs.com/blog

# Optional platform integrations
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=
LINKEDIN_VERSION=202609
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
SUBSTACK_EDITOR_URL=https://substack.com/home

# Run a daily topic shortlist at 8 AM America/Chicago
DAILY_HOUR=8
NEWS_DAYS=3
NEWS_LIMIT=6
# Start with true. Set false ONLY when publication integrations are connected and tested.
DRY_RUN=true
